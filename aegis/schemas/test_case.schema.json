{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AegisTestCase",
  "type": "object",
  "required": ["id", "name", "description", "pillar", "type", "severity", "applies_to", "mappings", "check", "remediation_id", "owner_role", "version"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$",
      "description": "Unique test ID, e.g. FAIR-001"
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "pillar": {
      "type": "string",
      "enum": [
        "Governance & Accountability",
        "Fairness",
        "Transparency",
        "Privacy & Data",
        "Safety & Security",
        "Reliability",
        "Human Oversight",
        "GenAI",
        "Training & Culture"
      ]
    },
    "type": {
      "type": "string",
      "enum": ["technical", "evidence", "process", "attestation"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "applies_to": {
      "type": "object",
      "properties": {
        "risk_tier": {
          "type": "array",
          "items": { "type": "string", "enum": ["unacceptable", "high", "limited", "minimal"] }
        },
        "model_type": {
          "type": "array",
          "items": { "type": "string", "enum": ["classification", "regression", "llm", "recommender", "other"] }
        },
        "lifecycle_stage": {
          "type": "array",
          "items": { "type": "string", "enum": ["development", "testing", "production", "deprecated"] }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["framework", "ref"],
        "properties": {
          "framework": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    },
    "inputs": { "type": "object" },
    "check": { "type": "object" },
    "frequency": { "type": "string" },
    "remediation_id": { "type": "string", "pattern": "^REM-" },
    "owner_role": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
