{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AegisRemediation",
  "type": "object",
  "required": ["id", "title", "steps", "effort", "owner_role", "org_wide_fix"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REM-",
      "description": "Remediation ID matching the test's remediation_id"
    },
    "title": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "effort": {
      "type": "string",
      "enum": ["S", "M", "L"],
      "description": "S <1wk, M 1-4wk, L >1mo"
    },
    "owner_role": { "type": "string" },
    "org_wide_fix": { "type": "boolean" },
    "resources": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
