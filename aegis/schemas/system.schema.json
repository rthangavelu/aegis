{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AISystem",
  "type": "object",
  "required": ["id", "name", "owner", "business_unit", "purpose", "model_type", "risk_tier", "lifecycle_stage"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "owner": { "type": "string" },
    "business_unit": { "type": "string" },
    "purpose": { "type": "string" },
    "model_type": {
      "type": "string",
      "enum": ["classification", "regression", "llm", "recommender", "other"]
    },
    "risk_tier": {
      "type": "string",
      "enum": ["unacceptable", "high", "limited", "minimal"]
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": ["development", "testing", "production", "deprecated"]
    },
    "endpoint": { "type": ["string", "null"] },
    "eval_dataset": { "type": ["string", "null"] },
    "data_sources": { "type": "array", "items": { "type": "string" } },
    "jurisdictions": { "type": "array", "items": { "type": "string" } },
    "mock": { "type": "boolean" }
  }
}
